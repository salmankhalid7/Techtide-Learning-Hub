# ── AI Task Evaluation (optional) ──────────────────────────────────────────
# Set AI_EVAL_ENABLED=true and provide an API key to use a hosted LLM for task
# grading. When unconfigured, or when a call fails, the evaluator automatically
# falls back to its deterministic heuristic so grading always completes.
# Provider: "groq" (default) — any OpenAI-compatible endpoint works, e.g.
#   Groq (default)    https://api.groq.com/openai/v1    llama-3.3-70b-versatile
#   OpenAI            https://api.openai.com/v1         gpt-4o-mini
#   OpenRouter        https://openrouter.ai/api/v1      openai/gpt-4o-mini
#   Ollama (local)    http://localhost:11434/v1         llama3.1
#   LM Studio (local) http://localhost:1234/v1          your-model
AI_EVAL_ENABLED=false
AI_EVAL_PROVIDER=groq
AI_EVAL_API_KEY=
AI_EVAL_MODEL=llama-3.3-70b-versatile
AI_EVAL_BASE_URL=https://api.groq.com/openai/v1
AI_EVAL_TEMPERATURE=0.2
AI_EVAL_MAX_TOKENS=2000
AI_EVAL_TIMEOUT_MS=30000