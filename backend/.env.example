GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="LearnX AI <noreply@learnxai.com>"

# ── AI Task Evaluation (optional) ──────────────────────────────────────────
# Set AI_EVAL_ENABLED=true and provide an API key to use a hosted LLM for task
# grading. When unconfigured, or when a call fails, the evaluator automatically
# falls back to its deterministic heuristic so grading always completes.
# Provider: "groq" (default) — any OpenAI-compatible endpoint works, e.g.
#   Groq (default)    https://api.groq.com/openai/v1    llama-3.3-70b-versatile
#   OpenAI            https://api.openai.com/v1         gpt-4o-mini
#   OpenRouter        https://openrouter.ai/api/v1      openai/gpt-4o-mini
#   Ollama (local)    http://localhost:11434/v1         llama3.1
#   LM Studio (local) http://localhost:1234/v1          your-model
AI_EVAL_ENABLED=false
AI_EVAL_PROVIDER=groq
AI_EVAL_API_KEY=
AI_EVAL_MODEL=llama-3.3-70b-versatile
AI_EVAL_BASE_URL=https://api.groq.com/openai/v1
AI_EVAL_TEMPERATURE=0.2
AI_EVAL_MAX_TOKENS=2000
AI_EVAL_TIMEOUT_MS=30000

# ── Payments / Marketplace (optional) ──────────────────────────────────────
# The app boots without payment keys; providers report "not configured" until
# credentials are set. Commission is the % of each sale retained by the platform
# (the instructor earns the remainder).
PAYMENT_COMMISSION_RATE=10
# Base URL used to build webhook links / redirect URLs (no trailing slash).
PAYMENT_WEBHOOK_BASE_URL=
PAYMENT_APP_BASE_URL=

# ── Stripe (international: USD/EUR cards, Apple/Google Pay) ────────────────
# STRIPE_ENABLED=true enables the adapter. Use test keys for development.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ── JazzCash (Pakistan: PKR) ───────────────────────────────────────────────
# Sandbox merchant credentials. JAZZCASH_BASE_URL can override the endpoint.
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_CURRENCY=PKR
JAZZCASH_SANDBOX=true
JAZZCASH_BASE_URL=
# Required only if your merchant tier supports the refund API.
JAZZCASH_REFUND_URL=

# ── EasyPaisa (Pakistan: PKR) ──────────────────────────────────────────────
# Sandbox merchant credentials. EASYPAISA_BASE_URL can override the endpoint.
EASYPAISA_ENABLED=false
EASYPAISA_MERCHANT_ID=
EASYPAISA_STORE_ID=
EASYPAISA_API_SECRET=
EASYPAISA_CURRENCY=PKR
EASYPAISA_SANDBOX=true
EASYPAISA_BASE_URL=
# Required only if your merchant tier supports the refund API.
EASYPAISA_REFUND_URL=